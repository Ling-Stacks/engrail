#  ActivationSystem -- CMake template
#
#  GENERATED by ./configure -- DO NOT EDIT (edit CMakeLists.txt.in).
#  Configure-time defaults are injected as variables; the normal
#  cmake -D overrides still work on the generated file.

cmake_minimum_required(VERSION @CMAKE_MIN_VERSION@)
project(ActivationSystem
    VERSION @VERSION@
    DESCRIPTION "@PROJECT_DESCRIPTION@"
    LANGUAGES C CXX)

set(CMAKE_C_STANDARD @CSTD_NUM@)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_CXX_STANDARD @CXXSTD_NUM@)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang|AppleClang")
    set(ACT_WARN_C @WARN_C_LIST@)
    set(ACT_WARN_CXX @WARN_CXX_LIST@)
elseif(MSVC)
    set(ACT_WARN_C /W4)
    set(ACT_WARN_CXX /W4)
endif()

set(ACT_PREFIX_HINT "@PREFIX@")

option(ACT_BUILD_TESTS  "build the test suite"  @BUILD_TESTS@)
option(ACT_BUILD_TOOLS  "build the vendor tools" @BUILD_TOOLS@)
option(ACT_BUILD_EXAMPLE "build the example app" @BUILD_EXAMPLES@)
option(ACT_BUILD_BENCH  "build the benchmark tool" @BUILD_BENCH@)
option(ACT_BUILD_SHARED "build the shared library" @BUILD_SHARED@)

set(ACT_CORE_SRCS @CMAKE_SRC_LIST@)

add_library(activation STATIC ${ACT_CORE_SRCS})
target_include_directories(activation PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_options(activation PRIVATE ${ACT_WARN_C})

if(ACT_BUILD_SHARED)
    add_library(activation_shared SHARED ${ACT_CORE_SRCS})
    target_include_directories(activation_shared PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
    set_target_properties(activation_shared PROPERTIES OUTPUT_NAME activation)
endif()

if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang|AppleClang")
    target_link_options(activation INTERFACE @LDFLAGS_CXX_ONLY@)
endif()

if(ACT_BUILD_TOOLS)
    add_executable(engrail-keygen tools/keygen/main.cpp)
    target_link_libraries(engrail-keygen PRIVATE activation)
    target_compile_options(engrail-keygen PRIVATE ${ACT_WARN_CXX})

    add_executable(engrail-integrity tools/integrity/main.cpp)
    target_link_libraries(engrail-integrity PRIVATE activation)
    target_compile_options(engrail-integrity PRIVATE ${ACT_WARN_CXX})

    if(ACT_BUILD_BENCH)
        add_executable(engrail-bench tools/bench/main.cpp)
        target_link_libraries(engrail-bench PRIVATE activation)
    endif()
endif()

if(ACT_BUILD_EXAMPLE)
    add_executable(simple_check examples/simple_check.cpp)
    target_link_libraries(simple_check PRIVATE activation)
endif()

if(ACT_BUILD_TESTS)
    enable_testing()
    foreach(t IN ITEMS @CMAKE_TEST_LIST@)
        add_executable(${t} tests/${t}.c)
        target_link_libraries(${t} PRIVATE activation)
        add_test(NAME ${t} COMMAND ${t})
    endforeach()
endif()

install(TARGETS activation
        ARCHIVE DESTINATION lib
        LIBRARY DESTINATION lib)
if(ACT_BUILD_TOOLS)
    install(TARGETS engrail-keygen engrail-integrity
            ARCHIVE DESTINATION lib
            RUNTIME DESTINATION bin)
endif()
install(DIRECTORY include/activation DESTINATION include)
