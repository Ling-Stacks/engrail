#  ActivationSystem -- Makefile template
#
#  GENERATED by ./configure -- DO NOT EDIT (changes belong in
#  Makefile.in). Every knob below is a variable so the build
#  adapts to any toolchain without touching this file.

# toolchain (injected by configure)
CC             = @CC@
CXX            = @CXX@
AR             = @AR@
CFLAGS         = @CFLAGS@
CXXFLAGS       = @CXXFLAGS@
LDFLAGS        = @LDFLAGS@
LDFLAGS_CXX    = @LDFLAGS_CXX@
WARN_CFLAGS    = @WARN_CFLAGS@
WARN_CXXFLAGS  = @WARN_CXXFLAGS@
CSTD           = @CSTD@
CXXSTD         = @CXXSTD@

# layout
PREFIX         = @PREFIX@
EXEC_PREFIX    = @EXEC_PREFIX@
BINDIR         = @BINDIR@
LIBDIR         = @LIBDIR@
INCLUDEDIR     = @INCLUDEDIR@
PKGCONFIGDIR   = @PKGCONFIGDIR@
DESTDIR        =

# product
VERSION        = @VERSION@
LIB_NAME       = @LIB_NAME@
INCLUDES       = @INCLUDE_DIR@

# feature switches (yes/no, from configure)
BUILD_TOOLS    = @BUILD_TOOLS@
BUILD_TESTS    = @BUILD_TESTS@
BUILD_EXAMPLES = @BUILD_EXAMPLES@
BUILD_BENCH    = @BUILD_BENCH@
BUILD_SHARED   = @BUILD_SHARED@

# sources (variable-driven lists)
CRYPTO_DIR     = @CRYPTO_DIR@
CORE_DIR       = @CORE_DIR@
CRYPTO_SRCS    = @CRYPTO_SRCS@
CORE_C_SRCS    = @CORE_C_SRCS@
CORE_CXX_SRCS  = @CORE_CXX_SRCS@
KEYGEN_SRCS    = @KEYGEN_SRCS@
INTEGRITY_SRCS = @INTEGRITY_SRCS@
BENCH_SRCS     = @BENCH_SRCS@
EXAMPLE_SRCS   = @EXAMPLE_SRCS@
TEST_SRCS      = @TEST_SRCS@

# derived (still variables, no literals)
BUILD_DIR      = @BUILD_DIR@
DIST_DIR       = @DIST_DIR@
CORE_SRCS      = $(CRYPTO_SRCS) $(CORE_C_SRCS)
LIB_OBJS       = $(patsubst %.c,$(BUILD_DIR)/%.o,$(CORE_SRCS)) \
                 $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(CORE_CXX_SRCS))
TEST_BINS      = $(addprefix $(BUILD_DIR)/,$(notdir $(TEST_SRCS:.c=)))
STATIC_LIB     = $(BUILD_DIR)/$(LIB_NAME).a
SHARED_EXT     = @SHARED_EXT@
SHARED_LIB     = $(BUILD_DIR)/$(LIB_NAME)$(SHARED_EXT)
# 共享库仅含纯 C API (语言绑定走 C ABI, 不含 C++ 封装/运行时)
SHARED_OBJS    = $(patsubst %.c,$(BUILD_DIR)/%.o,$(CORE_SRCS))
KEYGEN_BIN     = $(BUILD_DIR)/engrail-keygen
INTEGRITY_BIN  = $(BUILD_DIR)/engrail-integrity
BENCH_BIN      = $(BUILD_DIR)/engrail-bench
EXAMPLE_BIN    = $(BUILD_DIR)/simple_check
CDEMO_BIN      = $(BUILD_DIR)/c_api_demo

ALL_TOOLS = $(KEYGEN_BIN)
ifeq ($(BUILD_TOOLS),yes)
ALL_TOOLS += $(INTEGRITY_BIN)
ifeq ($(BUILD_BENCH),yes)
ALL_TOOLS += $(BENCH_BIN)
endif
endif

ifeq ($(BUILD_SHARED),yes)
ALL_LIBS = $(STATIC_LIB) $(SHARED_LIB)
else
ALL_LIBS = $(STATIC_LIB)
endif

.PHONY: all test e2e example demo amalgamation install clean distclean \
        bindings bindings-test help

SMOKE_BIN = $(BUILD_DIR)/smoke

all: $(ALL_LIBS) $(ALL_TOOLS) smoke-run
ifeq ($(BUILD_TESTS),yes)
all: $(TEST_BINS)
endif

# post-build self-test (disable with NO_SMOKETEST=1)
$(SMOKE_BIN): tests/smoke.c $(STATIC_LIB)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(WARN_CFLAGS) $(CSTD) $(INCLUDES) $< $(STATIC_LIB) $(LDFLAGS) -o $@

.PHONY: smoke-run
smoke-run: $(SMOKE_BIN)
ifeq ($(NO_SMOKETEST),)
	@./$(SMOKE_BIN) || { echo ""; echo "*** POST-BUILD SELF-TEST FAILED ***"; echo "*** the built library is inconsistent -- fix before shipping"; echo "*** (re-run only: make smoke-run / full: make check)"; exit 1; }
endif

.PHONY: smoke
smoke: $(SMOKE_BIN)
	@./$(SMOKE_BIN)

# static library
$(STATIC_LIB): $(LIB_OBJS)
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $(LIB_OBJS)

$(SHARED_LIB): $(SHARED_OBJS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -shared -o $@ $(SHARED_OBJS) $(LDFLAGS)

# compile rules (auto header deps via -MMD)
DEPFLAGS = -MMD -MP

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(WARN_CFLAGS) $(CSTD) $(INCLUDES) $(DEPFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(WARN_CXXFLAGS) $(CXXSTD) $(INCLUDES) $(DEPFLAGS) -c $< -o $@

-include $(shell find $(BUILD_DIR) -name '*.d' 2>/dev/null)

# tests
$(BUILD_DIR)/%: tests/%.c $(STATIC_LIB)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(WARN_CFLAGS) $(CSTD) $(INCLUDES) $< $(STATIC_LIB) $(LDFLAGS) -o $@

check: all
	@bash tests/run_all.sh

test: all
	@echo "== $(PROJECT_NAME) test suite =="
	@for t in $(TEST_BINS); do ./$$t || exit 1; done

e2e: all $(EXAMPLE_BIN)
	@ACT_LANG=$${ACT_LANG:-en} CXX="$(CXX)" CXXFLAGS="$(CXXFLAGS)" bash scripts/e2e.sh

# tools
$(KEYGEN_BIN): $(KEYGEN_SRCS) $(STATIC_LIB)
	$(CXX) $(CXXFLAGS) $(WARN_CXXFLAGS) $(CXXSTD) $(INCLUDES) $(KEYGEN_SRCS) \
		$(STATIC_LIB) $(LDFLAGS_CXX) -o $@

$(INTEGRITY_BIN): $(INTEGRITY_SRCS) $(STATIC_LIB)
	$(CXX) $(CXXFLAGS) $(WARN_CXXFLAGS) $(CXXSTD) $(INCLUDES) $(INTEGRITY_SRCS) \
		$(STATIC_LIB) $(LDFLAGS_CXX) -o $@

$(BENCH_BIN): $(BENCH_SRCS) $(STATIC_LIB)
	$(CXX) $(CXXFLAGS) $(CXXSTD) $(INCLUDES) $(BENCH_SRCS) \
		$(STATIC_LIB) $(LDFLAGS_CXX) -o $@

# examples / demos
example: $(EXAMPLE_BIN)

$(EXAMPLE_BIN): $(EXAMPLE_SRCS) $(STATIC_LIB)
	$(CXX) $(CXXFLAGS) $(WARN_CXXFLAGS) $(CXXSTD) $(INCLUDES) \
		-DACT_PUBKEY_HEX='"$$(cat $(BUILD_DIR)/demo_pubkey.hex 2>/dev/null || echo 0)"' \
		-DACT_PRODUCT_ID=1 $(EXAMPLE_SRCS) $(STATIC_LIB) $(LDFLAGS_CXX) -o $@

demo: $(CDEMO_BIN)
	@./$(CDEMO_BIN)

$(CDEMO_BIN): examples/c_api_demo.c $(STATIC_LIB)
	$(CC) $(CFLAGS) $(WARN_CFLAGS) $(CSTD) $(INCLUDES) $< $(STATIC_LIB) $(LDFLAGS) -o $@

# single-file amalgamation
amalgamation: $(STATIC_LIB)
	@mkdir -p $(DIST_DIR)
	python3 scripts/make_amalgamation.py $(DIST_DIR)

# language bindings
bindings:
	@bash scripts/bindings_test.sh

bindings-test: bindings

# install
install: all
	install -d $(DESTDIR)$(INCLUDEDIR)/activation
	install -d $(DESTDIR)$(LIBDIR)
	install -d $(DESTDIR)$(PKGCONFIGDIR)
	install -d $(DESTDIR)$(BINDIR)
	install -m 644 include/activation/*.h include/activation/*.hpp \
		$(DESTDIR)$(INCLUDEDIR)/activation/
	install -m 644 $(STATIC_LIB) $(DESTDIR)$(LIBDIR)/
ifeq ($(BUILD_SHARED),yes)
	install -m 755 $(SHARED_LIB) $(DESTDIR)$(LIBDIR)/
endif
ifeq ($(BUILD_TOOLS),yes)
	install -m 755 $(KEYGEN_BIN) $(INTEGRITY_BIN) $(DESTDIR)$(BINDIR)/
endif
	@sed -e "s|@PREFIX@|$(PREFIX)|g" -e "s|@VERSION@|$(VERSION)|g" \
		activation.pc.in > $(DESTDIR)$(PKGCONFIGDIR)/$(LIB_NAME).pc
	@echo "installed under $(DESTDIR)$(PREFIX)"

# cleaning
clean:
	rm -rf $(BUILD_DIR) $(DIST_DIR) build-cmake
	rm -f $(LIB_NAME).so $(LIB_NAME).dll *.tmp *.act

distclean: clean
	bash clean.sh

help:
	@echo "targets: all test e2e example demo amalgamation bindings install clean distclean"
	@echo "configured: CC=$(CC) CXX=$(CXX) PREFIX=$(PREFIX) VERSION=$(VERSION)"
